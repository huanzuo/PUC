// .vscode/launch.json
{
    "version": "0.2.0",
    "configurations": [
        // Node.js调试
        {
            "type": "node",
            "request": "launch",
            "name": "调试当前文件",
            "program": "${file}",
            "skipFiles": ["<node_internals>/**"]
        },
        
        // 浏览器调试
        {
            "type": "chrome",
            "request": "launch",
            "name": "Chrome调试",
            "url": "http://localhost:3000",
            "webRoot": "${workspaceFolder}",
            "sourceMaps": true,
            "trace": true
        },
        
        // 集成终端调试
        {
            "type": "node",
            "request": "attach",
            "name": "附加到进程",
            "port": 9229,
            "restart": true
        }
    ]
}
